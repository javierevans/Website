---
import fileIcon from "../icons/file-text.svg?raw";
import downloadIcon from "../icons/download.svg?raw";
import toolIcon from "../icons/tool.svg?raw";
import lightbulbIcon from "../icons/lightbulb.svg?raw";
import targetIcon from "../icons/target.svg?raw";
---

<section id="about">
 <div class="about-wrap">
    <div class="about-text">
      <span class="kicker">about</span>
      <h2>About Me</h2>

      <div class="about-bio-wrap" data-reveal>
        <span class="about-bio-quote-mark" aria-hidden="true">&#8220;</span>
        <p class="about-bio-text">
          Hey! I'm Javier Evans, a Computer Science student at The College of New Jersey with
          a passion for building software that is practical, useful, and easy to use.
        </p>
        <p class="about-bio-text">
          I enjoy developing websites and applications that solve real-world problems, and I'm
          especially interested in web development, full-stack development, and cybersecurity.
          I'm always looking for opportunities to learn new technologies, improve my skills,
          and build projects that challenge me to think creatively.
        </p>
        <p class="about-bio-text">
          Outside of coding, I enjoy gardening and working out at the gym. I'm always
          exploring new interests and finding ways to grow both personally and professionally.
        </p>
      </div>

      <div class="resume-buttons" data-reveal style="--reveal-i: 1">
        <a href="/Javier_evans_Resume.pdf" target="_blank" class="btn-primary">
          <span class="resume-btn-icon" set:html={fileIcon} />
          View Resume
        </a>

        <a href="/Javier_evans_Resume.pdf" download class="btn-resume">
          <span class="resume-btn-icon" set:html={downloadIcon} />
          Download Resume
        </a>
      </div>

      <div class="about-facts">
        <div class="about-fact-row" data-reveal style="--reveal-i: 2">
          <span class="about-fact-icon" set:html={toolIcon} />
          <span class="about-fact-text">Currently building: Garden Planner App</span>
        </div>
        <div class="about-fact-row" data-reveal style="--reveal-i: 3">
          <span class="about-fact-icon" set:html={lightbulbIcon} />
          <span class="about-fact-text">Interested in: web dev, cybersecurity, ML, robotics</span>
        </div>
        <div class="about-fact-row" data-reveal style="--reveal-i: 4">
          <span class="about-fact-icon" set:html={targetIcon} />
          <span class="about-fact-text">Goal: internship or co-op in 2026</span>
        </div>
      </div>

  </div>
</section>
