---
import "../styles/global.css";

import homeIcon from "../icons/home.svg?raw";
import userIcon from "../icons/user.svg?raw";
import terminalIcon from "../icons/terminal.svg?raw";
import activityIcon from "../icons/activity.svg?raw";
import folderIcon from "../icons/folder.svg?raw";
import fileIcon from "../icons/file-text.svg?raw";
import mailIcon from "../icons/mail.svg?raw";

const navLinks: { href: string; label: string; icon: string; external?: boolean }[] = [
  { href: "#welcome", label: "Home", icon: homeIcon },
  { href: "#about", label: "About", icon: userIcon },
  { href: "#skills", label: "Skills", icon: terminalIcon },
  { href: "#activity", label: "Activity", icon: activityIcon },
  { href: "#projects", label: "Projects", icon: folderIcon },
];

const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 008 10.93c.58.1.8-.25.8-.56v-2.17c-3.25.71-3.94-1.57-3.94-1.57-.53-1.35-1.3-1.71-1.3-1.71-1.07-.73.08-.72.08-.72 1.18.08 1.8 1.22 1.8 1.22 1.05 1.8 2.75 1.28 3.42.98.1-.76.41-1.28.75-1.57-2.6-.3-5.34-1.3-5.34-5.8 0-1.28.46-2.33 1.21-3.15-.12-.3-.53-1.53.12-3.18 0 0 .99-.32 3.25 1.2A11.2 11.2 0 0112 6.8c1 0 2 .13 2.94.38 2.26-1.52 3.25-1.2 3.25-1.2.65 1.65.24 2.88.12 3.18.75.82 1.21 1.87 1.21 3.15 0 4.52-2.75 5.49-5.36 5.79.42.36.8 1.09.8 2.2v3.27c0 .31.21.67.81.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>`;

// Same destinations as the desktop nav-center + nav-actions, flattened into
// one stacked list for the mobile menu (which has no room for two rows).
const mobileNavItems = [
  ...navLinks,
  { href: "/Javier_evans_Resume.pdf", label: "Resume", icon: fileIcon, external: true },
  { href: "#contact", label: "Contact", icon: mailIcon },
  { href: "https://github.com/javierevans", label: "GitHub", icon: githubIcon, external: true },
];
---
 <header>
        <nav>
            <div class="logo">
                <a href="/" aria-label="Javier Evans — home">
                    <span class="logo-mark">&lt;JE&gt;</span> Javier Evans
                </a>
            </div>

            <ul class="nav-center" data-nav-spy>
                {navLinks.map((link) => (
                  <li>
                    <a href={link.href} class="nav-icon-btn" aria-label={link.label}>
                      <span class="nav-icon" set:html={link.icon} />
                      <span class="nav-tooltip">{link.label}</span>
                    </a>
                  </li>
                ))}
            </ul>

            <ul class="nav-actions" data-nav-spy>
                <li>
                  <a
                    href="/Javier_evans_Resume.pdf"
                    target="_blank"
                    class="nav-icon-btn resume-btn"
                    aria-label="Resume"
                  >
                    <span class="nav-icon" set:html={fileIcon} />
                    <span class="nav-tooltip">Resume</span>
                  </a>
                </li>

                <li>
                  <a href="#contact" class="nav-icon-btn" aria-label="Contact">
                    <span class="nav-icon" set:html={mailIcon} />
                    <span class="nav-tooltip">Contact</span>
                  </a>
                </li>

                <li>
                  <a
                    href="https://github.com/javierevans"
                    target="_blank"
                    rel="noopener"
                    class="nav-icon-btn"
                    aria-label="GitHub Profile"
                  >
                    <span class="nav-icon" set:html={githubIcon} />
                    <span class="nav-tooltip">GitHub</span>
                  </a>
                </li>
            </ul>

            <button
              type="button"
              class="nav-hamburger"
              id="nav-hamburger"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
            </button>
        </nav>

        <div class="mobile-menu" id="mobile-menu" data-nav-spy>
          <ul>
            {mobileNavItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav-icon-btn mobile-menu-link"
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener" : undefined}
                >
                  <span class="nav-icon" set:html={item.icon} />
                  <span class="mobile-menu-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
    </header>

<script type="module" src="/scripts/navspy.js"></script>
<script type="module" src="/scripts/mobile-nav.js"></script>
