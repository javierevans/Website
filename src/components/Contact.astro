---
import mailIcon from "../icons/mail.svg?raw";
import phoneIcon from "../icons/phone.svg?raw";
import mapPinIcon from "../icons/map-pin.svg?raw";
import linkedinIconRaw from "../icons/linkedin.svg?raw";
import githubIconRaw from "../icons/github.svg?raw";

// These brand marks ship with no fill attribute (default SVG fill is black) —
// inject currentColor so they pick up the button's text color like every other icon here.
const linkedinIcon = linkedinIconRaw.replace("<svg ", '<svg fill="currentColor" ');
const githubIcon = githubIconRaw.replace("<svg ", '<svg fill="currentColor" ');

const socials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/javier-evans-854327412/", icon: linkedinIcon },
  { label: "GitHub", href: "https://github.com/javierevans", icon: githubIcon },
];

const chips = [
  { title: "Email", value: "javierevans509@gmail.com", href: "mailto:javierevans509@gmail.com", icon: mailIcon },
  { title: "Phone", value: "+1 (609) 733-8041", href: "tel:+16097338041", icon: phoneIcon },
  { title: "Location", value: "Ewing, NJ", href: null, icon: mapPinIcon },
];
---

<section id="contact">

  <div class="contact-wrap">

    <div class="contact-heading" data-reveal>
      <h2 class="bubble-badge">Contact Me</h2>
      <p class="contact-intro">
        Have a project, opportunity, or question? I’d love to hear from you.
        Feel free to reach out and let’s connect!
      </p>
    </div>

    <div class="contact-columns">

      <div class="contact-info-block" data-reveal>
        <div class="contact-chips">
          {chips.map((chip) => {
            const Tag = chip.href ? "a" : "div";
            return (
              <Tag href={chip.href || undefined} class="contact-chip">
                <span class="chip-icon-wrap">
                  <span class="chip-icon" set:html={chip.icon} />
                </span>
                <span class="chip-text">
                  <span class="chip-title">{chip.title}</span>
                  <span class="chip-value">{chip.value}</span>
                </span>
              </Tag>
            );
          })}
        </div>

        <span class="kicker">connect</span>
        <div class="contact-socials">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener"
              class="nav-icon-btn"
              aria-label={social.label}
            >
              <span class="nav-icon" set:html={social.icon} />
              <span class="nav-tooltip">{social.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="code-panel" data-reveal style="--reveal-i: 1">
        <div class="code-panel-bar">
          <span class="code-dot code-dot-a"></span>
          <span class="code-dot code-dot-b"></span>
          <span class="code-dot code-dot-c"></span>
          <span class="code-panel-title">contact.js</span>
        </div>

        <form id="contact-form" action="https://formspree.io/f/mkovzyea" method="POST">
          <input type="hidden" name="_subject" value="New message from portfolio site">

          <div class="code-field">
            <label for="name">name<span class="code-punct">:</span></label>
            <input type="text" id="name" name="name" required>
          </div>

          <div class="code-field">
            <label for="email">email<span class="code-punct">:</span></label>
            <input type="email" id="email" name="_replyto" required>
          </div>

          <div class="code-field">
            <label for="message">message<span class="code-punct">:</span></label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button id="send-btn" type="submit">Send</button>

          <!-- Status message goes here -->
          <p id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>

  </div>
</section>
<script type="module" src="/scripts/contact.js"></script>
