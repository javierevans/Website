---
import StarfieldBackground from "./StarfieldBackground.astro";
---
<section id="welcome">

  <StarfieldBackground />

  <div class="hero-container">

    <div class="hero-text">
      <span class="kicker">whoami</span>
      <h1>Javier Evans<span class="cursor">_</span></h1>

      <p><b>Computer Science Student | Software&nbsp;Developer</b></p>

      <div class="hero-buttons">
        <a href="#projects" class="btn-primary">View Projects</a>
        <a href="#contact" class="btn-outline">Contact Me</a>
      </div>
    </div>

    <div class="hero-image">
      <div class="hero-photo">
        <img src="/images/IMG_7475_VSCO.jpg" alt="Javier Evans" width="966" height="1207" />
      </div>
    </div>

  </div>

  <div class="scroll-cue-orbit" aria-hidden="true">
    <svg width="110" height="110" viewBox="0 0 110 110">
      <defs>
        <radialGradient id="scrollCueAtmOuter" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#beaaff" stop-opacity="0.3"/>
          <stop offset="60%" stop-color="#8fb8ff" stop-opacity="0.12"/>
          <stop offset="100%" stop-color="#8fb8ff" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="scrollCuePlanetBody" cx="32%" cy="28%" r="75%">
          <stop offset="0%" stop-color="#6d5cb8"/>
          <stop offset="35%" stop-color="#4a3d8f"/>
          <stop offset="75%" stop-color="#2a2260"/>
          <stop offset="100%" stop-color="#161238"/>
        </radialGradient>
        <linearGradient id="scrollCueSaucerBody" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#e8e6f5"/>
          <stop offset="50%" stop-color="#b3aed6"/>
          <stop offset="100%" stop-color="#6f6a99"/>
        </linearGradient>
        <radialGradient id="scrollCueDomeGlow" cx="50%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#d8f5ff"/>
          <stop offset="70%" stop-color="#7fd8f0"/>
          <stop offset="100%" stop-color="#3a9bb8"/>
        </radialGradient>
        <clipPath id="scrollCuePlanetClip"><circle cx="55" cy="46" r="15"/></clipPath>
      </defs>

      <circle cx="55" cy="46" r="34" fill="url(#scrollCueAtmOuter)"/>

      <circle cx="55" cy="46" r="15" fill="url(#scrollCuePlanetBody)"/>
      <g clip-path="url(#scrollCuePlanetClip)" opacity="0.55">
        <ellipse cx="48" cy="40" rx="5" ry="2.2" fill="#8a7bd6" opacity="0.5" transform="rotate(-15 48 40)"/>
        <ellipse cx="60" cy="50" rx="6" ry="2.5" fill="#221d4f" opacity="0.6" transform="rotate(10 60 50)"/>
        <ellipse cx="52" cy="52" rx="3" ry="1.4" fill="#221d4f" opacity="0.5"/>
        <circle cx="61" cy="39" r="2" fill="#221d4f" opacity="0.5"/>
        <circle cx="47" cy="49" r="1.4" fill="#8a7bd6" opacity="0.4"/>
        <ellipse cx="58" cy="42" rx="10" ry="3" fill="#5b4dae" opacity="0.3" transform="rotate(-20 58 42)"/>
      </g>
      <ellipse cx="50" cy="40" rx="5" ry="3.5" fill="#ffffff" opacity="0.15"/>

      <ellipse cx="55" cy="46" rx="25" ry="8.5" fill="none" stroke="#beaaff40" stroke-width="1"/>
      <ellipse cx="55" cy="46" rx="25" ry="8.5" fill="none" stroke="#beaaff20" stroke-width="4"/>

      <g id="scrollCueUfo">
        <ellipse cx="0" cy="1" rx="9" ry="3" fill="url(#scrollCueSaucerBody)"/>
        <ellipse cx="0" cy="0.5" rx="9" ry="1" fill="#fff" opacity="0.4"/>
        <path d="M -4 -1 Q 0 -7 4 -1 Z" fill="url(#scrollCueDomeGlow)"/>
        <circle cx="-5" cy="1.5" r="0.8" fill="#ffd9a8"/>
        <circle cx="0" cy="2" r="0.8" fill="#ffd9a8"/>
        <circle cx="5" cy="1.5" r="0.8" fill="#ffd9a8"/>
      </g>

      <line x1="55" y1="72" x2="55" y2="98" stroke="#beaaff44" stroke-width="1"/>
    </svg>
    <p class="scroll-cue-orbit-label">Explore</p>
  </div>

</section>

<style>
  .scroll-cue-orbit {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    text-align: center;
    cursor: pointer;
  }

  .scroll-cue-orbit-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .scroll-cue-orbit {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #scrollCueUfo {
      transform: translate(80px, 46px);
    }
  }
</style>

<script>
  (function () {
    const cue = document.querySelector<HTMLElement>('.scroll-cue-orbit');
    const ufo = document.getElementById('scrollCueUfo');
    if (!cue || !ufo) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      let t = 0;
      const cx = 55, cy = 46, rx = 25, ry = 8.5;
      function tick() {
        t += 0.03;
        const x = cx + rx * Math.cos(t);
        const y = cy + ry * Math.sin(t);
        const behind = Math.sin(t) > 0;
        ufo!.setAttribute('transform', `translate(${x},${y}) scale(${0.8 + 0.3 * Math.sin(t)})`);
        ufo!.style.opacity = behind ? '0.4' : '1';
        requestAnimationFrame(tick);
      }
      tick();
    }

    cue.addEventListener('click', () => {
      document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>